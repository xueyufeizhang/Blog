---
// Simple client-side TOC: finds h2-h4 inside .content and renders links
interface Props {
	label?: string;
}

const { label = 'On this page' } = Astro.props;
---

<nav class="toc mb-6 p-0 text-sm" aria-label="Table of contents">
	<p
		class="mb-3 text-[0.68rem] font-bold tracking-[0.15em] text-stone-500 uppercase dark:text-stone-400"
	>
		{label}
	</p>
	<div class="toc-scroll" data-toc-scroll>
		<div class="border-l border-stone-300 dark:border-stone-700">
			<ul id="toc-list" class="space-y-1.5"></ul>
		</div>
	</div>
</nav>

<script>
	const levels = new Set([2, 3, 4]);

	function slugify(text: string) {
		return (text || '')
			.toLowerCase()
			.trim()
			.replace(/[^a-z0-9\u4e00-\u9fa5\s-]/g, '')
			.replace(/\s+/g, '-')
			.replace(/-+/g, '-');
	}

	function ensureId(el: HTMLElement, usedIds: Set<string>) {
		const baseId = el.id || slugify(el.textContent || '') || 'section';
		let id = baseId;
		let suffix = 1;

		while (
			usedIds.has(id) ||
			(document.getElementById(id) !== null && document.getElementById(id) !== el)
		) {
			id = `${baseId}-${suffix}`;
			suffix += 1;
		}

		el.id = id;
		usedIds.add(id);
		return id;
	}

	function buildTOC(): HTMLElement[] {
		const container = document.querySelector<HTMLElement>('.content');
		const list = document.querySelector<HTMLUListElement>('#toc-list');
		const aside = document.querySelector<HTMLElement>('[data-post-toc]');
		if (!container || !list) return [];

		const hs = Array.from(container.querySelectorAll<HTMLElement>('h2, h3, h4')).filter((h) =>
			levels.has(parseInt(h.tagName.substring(1), 10))
		);

		if (hs.length === 0) {
			aside?.setAttribute('hidden', '');
			return [];
		}

		list.innerHTML = '';
		const usedIds = new Set<string>();
		hs.forEach((h) => {
			const id = ensureId(h, usedIds);
			const level = h.tagName.toLowerCase();
			const li = document.createElement('li');
			li.className =
				level === 'h4'
					? 'toc-item toc-item-deep'
					: level === 'h3'
						? 'toc-item toc-item-nested'
						: 'toc-item';

			const a = document.createElement('a');
			a.href = `#${id}`;
			a.textContent = h.textContent || '';
			a.className = 'toc-link';

			li.appendChild(a);
			list.appendChild(li);
		});

		// Smooth scroll and manual activation on click
		list.addEventListener('click', (e) => {
			const a = e.target instanceof Element ? e.target.closest<HTMLAnchorElement>('a') : null;
			if (!a) return;
			e.preventDefault();
			const targetId = (a.getAttribute('href') || '').replace('#', '');
			const target = document.getElementById(targetId);
			if (target) {
				navigationTargetId = targetId;
				scheduleNavigationRelease();
				const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches
					? 'auto'
					: 'smooth';
				target.scrollIntoView({ behavior, block: 'start' });
				activateLink(targetId);
				history.replaceState(null, '', `#${targetId}`);
			}
		});

		return hs;
	}

	let activeId = '';
	let navigationTargetId = '';
	let navigationReleaseTimer = 0;
	let activeCenterTimer = 0;
	let pendingCenterLink: HTMLAnchorElement | null = null;
	let refreshActiveHeading = () => {};

	function scheduleNavigationRelease() {
		window.clearTimeout(navigationReleaseTimer);
		navigationReleaseTimer = window.setTimeout(() => {
			navigationTargetId = '';
			refreshActiveHeading();
		}, 140);
	}

	function scheduleActiveCenter(link: HTMLAnchorElement, delay = 180) {
		pendingCenterLink = link;
		window.clearTimeout(activeCenterTimer);
		activeCenterTimer = window.setTimeout(() => {
			if (pendingCenterLink) centerActiveLink(pendingCenterLink);
		}, delay);
	}

	function postponeActiveCenter() {
		if (pendingCenterLink) scheduleActiveCenter(pendingCenterLink);
	}

	function centerActiveLink(link: HTMLAnchorElement) {
		const scrollContainer = link.closest<HTMLElement>('[data-toc-scroll]');
		if (!scrollContainer || scrollContainer.scrollHeight <= scrollContainer.clientHeight) return;

		const targetTop =
			link.offsetTop - (scrollContainer.clientHeight - link.offsetHeight) / 2;

		scrollContainer.scrollTo({ top: targetTop, behavior: 'smooth' });
	}

	function activateLink(id: string) {
		if (!id || id === activeId) return;
		let activeLink: HTMLAnchorElement | null = null;
		for (const a of document.querySelectorAll<HTMLAnchorElement>('#toc-list a')) {
			const match = a.getAttribute('href') === `#${id}`;
			a.classList.toggle('is-active', match);
			if (match) {
				a.setAttribute('aria-current', 'true');
				activeLink = a;
			} else {
				a.removeAttribute('aria-current');
			}
		}

		activeId = id;
		if (activeLink) {
			scheduleActiveCenter(activeLink);
		}
	}

	function initScrollSpy(headings: HTMLElement[]) {
		let scheduled = false;

		function updateActiveHeading() {
			scheduled = false;
			const marker = Math.min(window.innerHeight * 0.32, 280);
			let current = headings[0];
			const atPageEnd =
				window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;

			if (atPageEnd) {
				current = headings[headings.length - 1];
			} else {
				for (const heading of headings) {
					if (heading.getBoundingClientRect().top <= marker) {
						current = heading;
					} else {
						break;
					}
				}
			}

			if (current?.id) activateLink(current.id);
		}

		function scheduleUpdate() {
			postponeActiveCenter();
			if (navigationTargetId) {
				scheduleNavigationRelease();
				return;
			}
			if (scheduled) return;
			scheduled = true;
			requestAnimationFrame(updateActiveHeading);
		}

		refreshActiveHeading = updateActiveHeading;
		window.addEventListener('scroll', scheduleUpdate, { passive: true });
		window.addEventListener('resize', scheduleUpdate, { passive: true });
		updateActiveHeading();
	}

	function start() {
		const headings = buildTOC();
		if (headings.length > 0) initScrollSpy(headings);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', start);
	} else {
		start();
	}
</script>

<style is:global>
	.toc {
		--toc-panel-height: calc(100vh - 11.5rem);
		display: flex;
		max-height: var(--toc-panel-height);
		min-height: 0;
		flex-direction: column;
	}

	.toc-scroll {
		position: relative;
		min-height: 0;
		overflow-y: auto;
		overflow-anchor: none;
		overscroll-behavior-y: contain;
		padding: 0.15rem 0.2rem 0.15rem 0;
		-ms-overflow-style: none;
		scrollbar-width: none;
	}

	.toc-scroll::after {
		content: '';
		display: block;
		height: calc(var(--toc-panel-height) / 2);
		pointer-events: none;
	}

	.toc-scroll::-webkit-scrollbar {
		display: none;
	}

	.toc-link {
		display: block;
		margin-left: -1px;
		border-left: 2px solid transparent;
		padding: 0.3rem 0 0.3rem 0.85rem;
		color: rgb(87 83 78);
		font-size: 0.78rem;
		line-height: 1.45;
		transition:
			background-color 160ms ease,
			border-color 160ms ease,
			color 160ms ease,
			transform 160ms ease;
	}

	.toc-link:hover,
	.toc-link.is-active {
		border-left-color: rgb(249 115 22);
		color: rgb(194 65 12);
	}

	.toc-link.is-active {
		background: linear-gradient(90deg, rgb(255 247 237 / 90%), transparent);
		font-weight: 700;
	}

	.toc-link:focus-visible {
		border-radius: 0 0.35rem 0.35rem 0;
		outline: 2px solid rgb(249 115 22 / 65%);
		outline-offset: -2px;
	}

	.toc-item-nested .toc-link {
		padding-left: 1.5rem;
		color: rgb(120 113 108);
		font-size: 0.74rem;
	}

	.toc-item-deep .toc-link {
		padding-left: 2.1rem;
		color: rgb(120 113 108);
		font-size: 0.72rem;
	}

	.dark .toc-link {
		color: rgb(214 211 209);
	}

	.dark .toc-link:hover,
	.dark .toc-link.is-active {
		color: rgb(251 146 60);
	}

	.dark .toc-link.is-active {
		background: linear-gradient(90deg, rgb(124 45 18 / 22%), transparent);
	}
</style>
