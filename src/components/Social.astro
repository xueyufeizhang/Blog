---
interface Props {
	href: string;
}

const { href } = Astro.props;
---

<div
	class="group h-11 w-full rounded-xl bg-stone-300/70 p-[1px] shadow-[inset_0_0_0_1px_rgba(255,255,255,0.45)] transition-all duration-300 ease-out hover:-translate-y-0.5 hover:bg-gradient-to-br hover:from-orange-300/70 hover:via-amber-200/45 hover:to-stone-300/70 hover:shadow-[0_10px_24px_-16px_rgba(234,88,12,0.55)] dark:bg-stone-700/70 dark:hover:from-orange-500/40 dark:hover:via-amber-500/20 dark:hover:to-stone-700/70 dark:hover:shadow-[0_10px_24px_-16px_rgba(251,146,60,0.35)]"
>
	<a
		href={href}
		target="_blank"
		class="flex h-full w-full items-center justify-center rounded-[0.7rem] bg-stone-300/95
		p-4
		text-gray-900
		transition-colors duration-300 group-hover:bg-stone-200/95
    dark:bg-stone-800
		dark:text-white dark:group-hover:bg-stone-800/95"
	>
		<slot />
	</a>
</div>
