---
import { formatDate, formatPostLabel, getPostUpdatedDate } from '@/utils/data.util';
import Tags from './Tags.astro';

interface Props {
	post: any;
}

const { post } = Astro.props;
const isPinned = post.frontmatter.isPinned === true;
const { type, status, language, updatedDate } = post.frontmatter;
const displayDate = getPostUpdatedDate(post);

const fileUrl = post.file;
const slug = fileUrl.split('/').slice(-2, -1)[0]; 
const cleanUrl = `/posts/${slug}`; // 构建最终的浏览器访问路径
---

<a href={cleanUrl} class="group block h-full">
	<div
		class="h-full rounded-2xl bg-stone-300/70 p-[1px] text-sm shadow-[inset_0_0_0_1px_rgba(255,255,255,0.45)] transition-all duration-300 ease-out group-hover:-translate-y-0.5 group-hover:bg-gradient-to-br group-hover:from-orange-300/65 group-hover:via-amber-200/40 group-hover:to-stone-300/70 group-hover:shadow-[0_16px_36px_-24px_rgba(234,88,12,0.55)] dark:bg-stone-700/70 dark:group-hover:from-orange-500/35 dark:group-hover:via-amber-500/15 dark:group-hover:to-stone-700/70 dark:group-hover:shadow-[0_16px_36px_-24px_rgba(251,146,60,0.3)]"
	>
		<div
			class="flex h-full w-full flex-col rounded-[1rem] bg-stone-300/95 p-4 text-gray-900 transition-colors duration-300 group-hover:bg-stone-200/95 dark:bg-stone-800 dark:text-white dark:group-hover:bg-stone-800/95"
		>
			<div class="flex-auto">
				<div class="flex flex-wrap items-center justify-between gap-2 pb-4 text-xs">
					<div class="flex items-center gap-2">
						{isPinned && (
							<span class="flex items-center gap-1 font-bold text-orange-600 dark:text-orange-400">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V6h1a2 2 0 0 0 0-4H8a2 2 0 0 0 0 4h1v4.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24Z"></path>
									<line x1="12" y1="17" x2="12" y2="22"></line>
								</svg>
							</span>
						)}
						<p>{updatedDate ? 'Updated ' : ''}{formatDate(displayDate)}</p>
					</div>
					<div>
						<p class="font-bold">{post.frontmatter.minutesRead}</p>
					</div>
				</div>

				<p class="pb-4 text-lg font-bold">{post.frontmatter.title}</p>

				<div class="flex flex-wrap gap-2 pb-3 text-[10px] font-bold uppercase tracking-wide text-stone-500 dark:text-stone-400">
					{type && <span>{formatPostLabel(type)}</span>}
					{status && <span>· {formatPostLabel(status)}</span>}
					{language && <span>· {language.toUpperCase()}</span>}
				</div>
				<Tags tags={post.frontmatter.tags} />
				<p class="line-clamp-4 pt-4 leading-6 sm:line-clamp-6">{post.frontmatter.excerpt}</p>
			</div>
			<p class="pt-4 underline">continue reading →</p>
		</div>
	</div>
</a>
