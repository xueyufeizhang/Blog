---
import Base from '@/layouts/Base.astro';
import Heading from '@/components/Heading.astro';
import Section from '@/components/Section.astro';
import { AppConfig } from '@/utils/AppConfig';

interface Props {
	title: string;
	description: string;
	lastUpdated: string;
}

const { title, description, lastUpdated } = Astro.props;
---

<Base head={{ title: `${title} | ${AppConfig.site_name}`, description }}>
	<Section>
		<Heading title={title} />
		<p class="mt-3 text-sm text-stone-500 dark:text-stone-400">Last updated: {lastUpdated}</p>
	</Section>

	<Section>
		<article class="legal-copy">
			<slot />
		</article>
	</Section>
</Base>

<style>
	.legal-copy {
		font-family: ui-sans-serif, system-ui, sans-serif;
		font-size: 0.95rem;
		line-height: 1.75;
	}

	.legal-copy :global(h2) {
		margin-top: 2rem;
		margin-bottom: 0.75rem;
		font-size: 1.35rem;
		font-weight: 700;
	}

	.legal-copy :global(h2:first-child) {
		margin-top: 0;
	}

	.legal-copy :global(p),
	.legal-copy :global(ul) {
		margin-bottom: 1rem;
	}

	.legal-copy :global(ul) {
		list-style: disc;
		padding-left: 1.5rem;
	}

	.legal-copy :global(a) {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.legal-copy :global(a:hover) {
		color: #ea580c;
	}

	.legal-copy :global(.legal-note) {
		border-left: 3px solid #ea580c;
		padding-left: 1rem;
		color: #57534e;
	}

	:global(.dark) .legal-copy :global(.legal-note) {
		color: #a8a29e;
	}
</style>
