---
import Section from './Section.astro';
import Card from './Card.astro';
import Heading from './Heading.astro';
import { MarkdownInstance } from 'astro';

interface Props {
	posts: MarkdownInstance<any>[];
	heading?: string;
	href?: string;
	linkLabel?: string;
}

const {
	posts,
	heading = 'Latest notes',
	href = '/posts',
	linkLabel = 'browse all →'
} = Astro.props;
---

<Section>
	<div class="flex justify-between items-center pb-4">
		<Heading title={heading} />
		<a href={href} class="underline hover:text-orange-600">{linkLabel}</a>
	</div>
	<div class="flex flex-col pb-4 md:flex-row">
		{
			posts.map((post: any) => (
				<div class="mb-4 basis-1 last:mr-0 md:mr-4 md:basis-1/3">
					<Card post={post} />
				</div>
			))
		}
	</div>
</Section>
