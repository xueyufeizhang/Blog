---
import { formatDate, formatPostLabel } from '@/utils/data.util';
import Tags from './Tags.astro';
// import PinnedBadge from './PinnedBadge.astro'; // 不再需要这个组件

interface Props {
	title: string;
	author: string;
	tags: string[];
	minutesRead: string;
	pubDate: string;
	updatedDate?: string;
	type?: string;
	status?: string;
	language?: string;
	isPinned?: boolean;
	img: {
		src: string;
		alt: string;
	};
}

const {
	title,
	pubDate,
	updatedDate,
	type,
	status,
	language,
	tags,
	minutesRead,
	img,
	isPinned = false
} = Astro.props;

const formattedDate = formatDate(pubDate);
---

	<header class="flex flex-col items-center">
		<div class="max-w-4xl py-2 text-center sm:px-4 sm:py-4">
			<h1 class="break-words text-[clamp(1.8rem,5vw,2.5rem)] font-bold leading-[1.18] tracking-[-0.035em]">{title}</h1>
		</div>

		<div class="pb-3 pt-2">
			<Tags tags={tags} withHref={true} />
		</div>

		{(type || status || language) && (
			<div class="mb-3 flex flex-wrap items-center justify-center gap-2 text-[0.7rem] font-bold uppercase tracking-[0.12em] text-stone-500 dark:text-stone-400">
				{type && <span>{formatPostLabel(type)}</span>}
				{status && <span>· {formatPostLabel(status)}</span>}
				{language && <span>· {language.toUpperCase()}</span>}
			</div>
		)}

		<div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-center text-xs text-stone-500 dark:text-stone-400 sm:text-sm">
			
			{/* 如果是置顶文章，显示橙色 Top 标记 */}
			{isPinned && (
				<span class="flex items-center gap-1 font-bold text-orange-600 dark:text-orange-400">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V6h1a2 2 0 0 0 0-4H8a2 2 0 0 0 0 4h1v4.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24Z"></path>
						<line x1="12" y1="17" x2="12" y2="22"></line>
					</svg>
					Top
				</span>
			)}

			<span>Created {formattedDate}</span>

			{updatedDate && <span>Updated {formatDate(updatedDate)}</span>}
			
			<span class="hidden h-3 w-px bg-stone-300 sm:inline dark:bg-stone-700" aria-hidden="true"></span>
			
			<span>{minutesRead}</span>
		</div>

		{/* 图片区域 */}
		{img.src ? (
			<div class="mt-6 w-full sm:mt-8">
				<img 
					src={img.src} 
					alt={img.alt} 
					class="mx-auto rounded-xl shadow-sm"
				/>
			</div>
		) : null}
	</header>
