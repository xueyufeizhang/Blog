---
import { AppConfig } from '@/utils/AppConfig';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';

const { title } = AppConfig;
const { description } = AppConfig;
---

<Base head={{ title: `Page not found | ${title}`, description }}>
  <Section>
    <div class="my-12 text-center">
		<h1 class="text-5xl font-bold">404</h1>
      <p class="mt-4 text-stone-600 dark:text-stone-400">This page wandered off somewhere.</p>
      <a href="/" class="mt-6 inline-block underline hover:text-orange-600">Back to the homepage →</a>
    </div>
  </Section>
</Base>
