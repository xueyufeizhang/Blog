---
import { AppConfig } from '@/utils/AppConfig';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import GitHubContributions from '@/components/GitHubActivityCalendar.astro';
import LatestPosts from '@/components/LatestPosts.astro';
import AllTags from '@/components/AllTags.astro';
import { isPublishedPost, sortPostsByUpdatedDate } from '@/utils/data.util';
import { MarkdownInstance } from 'astro';

const { title } = AppConfig;
const { description } = AppConfig;

const allPosts = Object.values(
	import.meta.glob('../content/posts/**/index.md', { eager: true })
) as MarkdownInstance<any>[];
const publishedPosts = allPosts.filter(isPublishedPost);
publishedPosts.sort(sortPostsByUpdatedDate);
const recentlyUpdatedPosts = publishedPosts.slice(0, 3);
---

<Base head={{ title, description }}>
	<Hero />

	<section aria-label="GitHub activity">
		<div class="mx-auto my-3 w-full max-w-screen-lg px-5 sm:my-6 sm:px-4">
			<GitHubContributions username="xueyufeizhang" recentMonths={12} />
		</div>
	</section>

	<AllTags />
	<LatestPosts
		posts={recentlyUpdatedPosts}
		heading="Recently updated"
		href="/archive"
		linkLabel="open archive →"
	/>
</Base>
