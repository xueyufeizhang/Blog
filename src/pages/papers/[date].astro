---
import Base from '@/layouts/Base.astro';
import PostContent from '@/components/PostContent.astro';
import ScrollToTop from '@/components/ScrollToTop.astro';
import Section from '@/components/Section.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import {
	formatPaperDigestDate,
	formatPaperDigestDateZh,
	getPaperDigestDate,
	getPaperDigestSlug,
	loadPaperDigests,
	type PaperDigest
} from '@/features/paper-digests/data';

export function getStaticPaths() {
	return loadPaperDigests().map((digest) => ({
		params: { date: getPaperDigestSlug(digest) },
		props: { digest }
	}));
}

const { digest } = Astro.props as { digest: PaperDigest };
const { Content } = digest;
const {
	title,
	titleZh,
	pubDate,
	description,
	descriptionZh,
	paperCount,
	generatedAt,
	language = 'en'
} = digest.frontmatter;
const publishedDate = getPaperDigestDate(digest);
const publishedIso = publishedDate.toISOString();
---

<Base head={{ title: `${title} / ${titleZh}`, description: `${description} ${descriptionZh}` }}>
	<Section>
		<header
			class="relative mx-auto mb-9 max-w-4xl overflow-hidden rounded-[2rem] border border-stone-200 bg-stone-50 px-6 py-9 sm:mb-12 sm:px-10 sm:py-12 dark:border-stone-800 dark:bg-stone-900/60"
		>
			<div
				class="pointer-events-none absolute -top-20 -right-16 h-64 w-64 rounded-full bg-orange-200/35 blur-3xl dark:bg-orange-900/20"
			>
			</div>
			<div class="relative">
				<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
					<p
						class="text-[0.66rem] font-bold tracking-[0.18em] text-orange-700 uppercase dark:text-orange-400"
					>
						Bilingual research brief · 双语研究简报
					</p>
					<a
						href="/papers"
						class="text-[0.66rem] font-bold tracking-[0.12em] text-stone-500 uppercase transition hover:text-orange-700 dark:text-stone-400 dark:hover:text-orange-400"
					>
						All digests / 全部日报 <span aria-hidden="true">↗</span>
					</a>
				</div>

				<h1
					class="max-w-3xl text-[clamp(2rem,6vw,3.6rem)] leading-[1.02] font-black tracking-[-0.055em] text-stone-950 dark:text-stone-50"
				>
					{title}
				</h1>
				<p
					class="mt-3 text-lg font-semibold text-stone-500 sm:text-xl dark:text-stone-400"
					lang="zh-CN"
				>
					{titleZh}
				</p>

				<div
					class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-stone-500 dark:text-stone-400"
				>
					<time datetime={publishedIso}>
						{formatPaperDigestDate(pubDate)} / {formatPaperDigestDateZh(pubDate)}
					</time>
					<span aria-hidden="true">·</span>
					<span>{paperCount} {paperCount === 1 ? 'paper' : 'papers'} / {paperCount} 篇论文</span>
					{generatedAt && <span aria-hidden="true">·</span>}
					{generatedAt && <span>AI-assisted review / AI 辅助整理</span>}
				</div>

				<div
					class="mt-7 grid gap-5 border-t border-stone-200 pt-6 md:grid-cols-2 dark:border-stone-700"
				>
					<div>
						<p class="mb-2 text-[0.62rem] font-bold tracking-[0.14em] text-stone-400 uppercase">
							English
						</p>
						<p class="text-sm leading-6 text-stone-700 dark:text-stone-300">{description}</p>
					</div>
					<div
						class="md:border-l md:border-stone-200 md:pl-5 dark:md:border-stone-700"
						lang="zh-CN"
					>
						<p class="mb-2 text-[0.62rem] font-bold tracking-[0.14em] text-stone-400 uppercase">
							中文
						</p>
						<p class="text-sm leading-6 text-stone-700 dark:text-stone-300">{descriptionZh}</p>
					</div>
				</div>
			</div>
		</header>

		<div class="relative grid items-start" data-reading-layout>
			<main class="col-start-1 row-start-1 mx-auto w-full max-w-3xl min-w-0">
				<article class="content paper-digest-content" data-pagefind-body lang={language}>
					<div class="hidden" data-pagefind-ignore>
						<h1 data-pagefind-meta="title">{title} / {titleZh}</h1>
						<span data-pagefind-meta="description">{description} {descriptionZh}</span>
						<span data-pagefind-meta="date">{publishedIso.slice(0, 10)}</span>
						<span data-pagefind-filter="Type" data-pagefind-meta="type">Paper Digest</span>
					</div>
					<PostContent><Content /></PostContent>
				</article>
			</main>

			<aside
				class="sticky top-20 col-start-1 row-start-1 hidden w-56 xl:block"
				style="margin-left: calc(50% + 26rem);"
				data-post-toc
			>
				<TableOfContents label="On this page / 本页目录" />
			</aside>
		</div>
	</Section>
	<ScrollToTop />
</Base>

<style is:global>
	.paper-digest-content .note-content {
		font-size: 1rem;
		line-height: 1.85;
	}

	.paper-digest-content .note-content > blockquote:first-child {
		margin: 0 0 3.5rem;
		border: 1px solid rgb(214 211 209);
		border-left: 4px solid rgb(234 88 12);
		border-radius: 0 1rem 1rem 0;
		background: linear-gradient(135deg, rgba(255, 247, 237, 0.95), rgba(250, 250, 249, 0.7));
		padding: 1rem 1.25rem;
		font-weight: 400;
	}

	.paper-digest-content .note-content > blockquote:first-child p:first-of-type::before,
	.paper-digest-content .note-content > blockquote:first-child p:last-of-type::after {
		content: none;
	}

	.dark .paper-digest-content .note-content > blockquote:first-child {
		border-color: rgb(68 64 60);
		border-left-color: rgb(251 146 60);
		background: linear-gradient(135deg, rgba(124, 45, 18, 0.2), rgba(28, 25, 23, 0.55));
	}

	.paper-digest-content .note-content h2 {
		margin-top: 4.75rem;
		margin-bottom: 1.35rem;
		border: 1px solid rgb(214 211 209);
		border-left: 5px solid rgb(234 88 12);
		border-radius: 0 1rem 1rem 0;
		background: rgba(250, 250, 249, 0.82);
		padding: 1.1rem 1.25rem;
		font-family:
			ui-sans-serif,
			-apple-system,
			BlinkMacSystemFont,
			'Segoe UI',
			sans-serif;
		font-size: clamp(1.3rem, 3.8vw, 1.65rem);
		line-height: 1.3;
		letter-spacing: -0.035em;
		box-shadow: 0 8px 24px rgba(28, 25, 23, 0.045);
	}

	.dark .paper-digest-content .note-content h2 {
		border-color: rgb(68 64 60);
		border-left-color: rgb(251 146 60);
		background: rgba(41, 37, 36, 0.62);
		box-shadow: none;
	}

	.paper-digest-content .note-content h2 a {
		transition: color 160ms ease;
	}

	.paper-digest-content .note-content h2 a:hover {
		color: rgb(194 65 12);
	}

	.dark .paper-digest-content .note-content h2 a:hover {
		color: rgb(251 146 60);
	}

	.paper-digest-content .note-content h3 {
		margin-top: 3rem;
		margin-bottom: 1.15rem;
		border-top: 1px solid rgb(231 229 228);
		padding-top: 1.25rem;
		font-family:
			ui-sans-serif,
			-apple-system,
			BlinkMacSystemFont,
			'Segoe UI',
			sans-serif;
		font-size: clamp(1.1rem, 3vw, 1.28rem);
		letter-spacing: -0.025em;
	}

	.dark .paper-digest-content .note-content h3 {
		border-top-color: rgb(68 64 60);
	}

	.paper-digest-content .note-content p:has(> strong:only-child) {
		width: fit-content;
		margin-top: 1.3rem;
		margin-bottom: -0.55rem;
		border: 1px solid rgb(214 211 209);
		border-radius: 999px;
		background: rgb(245 245 244);
		padding: 0.08rem 0.58rem;
		font-size: 0.66rem;
		line-height: 1.6;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.dark .paper-digest-content .note-content p:has(> strong:only-child) {
		border-color: rgb(68 64 60);
		background: rgb(41 37 36);
	}

	.paper-digest-content .note-content .note-table-scroll {
		margin-top: 1.25rem;
		margin-bottom: 2.2rem;
	}

	.paper-digest-content .note-content table {
		min-width: 100%;
		white-space: normal;
	}

	.paper-digest-content .note-content th:first-child,
	.paper-digest-content .note-content td:first-child {
		width: 13rem;
		font-weight: 650;
	}

	.paper-digest-content .note-content hr {
		margin-block: 4.75rem;
	}

	@media (max-width: 640px) {
		.paper-digest-content .note-content > blockquote:first-child {
			margin-bottom: 2.75rem;
			padding: 0.85rem 1rem;
		}

		.paper-digest-content .note-content h2 {
			margin-top: 3.5rem;
			padding: 0.9rem 1rem;
		}

		.paper-digest-content .note-content h3 {
			margin-top: 2.5rem;
		}

		.paper-digest-content .note-content table {
			min-width: 38rem;
		}
	}
</style>
