---
import Base from '@/layouts/Base.astro';
import PostContent from '@/components/PostContent.astro';
import ScrollToTop from '@/components/ScrollToTop.astro';
import Section from '@/components/Section.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import { AppConfig } from '@/utils/AppConfig';
import {
	formatPaperDigestDate,
	getPaperDigestDate,
	getPaperDigestSlug,
	loadPaperDigests,
	type PaperDigest
} from '@/features/paper-digests/data';

export function getStaticPaths() {
	return loadPaperDigests().map((digest) => ({
		params: { date: getPaperDigestSlug(digest) },
		props: { digest }
	}));
}

const { digest } = Astro.props as { digest: PaperDigest };
const { Content } = digest;
const { title, pubDate, paperCount, language = 'en' } = digest.frontmatter;
const publishedDate = getPaperDigestDate(digest);
const publishedIso = publishedDate.toISOString();
---

<Base head={{ title: `${title} | ${AppConfig.site_name}`, description: AppConfig.description }}>
	<Section>
		<header
			class="mx-auto mb-10 max-w-4xl border-b border-stone-300 py-6 sm:mb-12 sm:py-9 dark:border-stone-700"
		>
			<div class="mb-5 flex flex-wrap items-center justify-between gap-3">
				<p
					class="text-xs font-bold tracking-[0.15em] text-orange-700 uppercase dark:text-orange-400"
				>
					Research brief
				</p>
				<a
					href="/papers"
					class="text-xs font-bold tracking-[0.1em] text-stone-500 uppercase transition hover:text-orange-700 dark:text-stone-400 dark:hover:text-orange-400"
				>
					All digests <span aria-hidden="true">↗</span>
				</a>
			</div>

			<h1
				class="max-w-3xl text-[clamp(2rem,6vw,3.5rem)] leading-[1.03] font-black tracking-[-0.055em] text-stone-950 dark:text-stone-50"
			>
				{title}
			</h1>
			<p class="mt-5 text-xs text-stone-500 dark:text-stone-400">
				<time datetime={publishedIso}>{formatPaperDigestDate(pubDate)}</time>
				<span class="mx-2" aria-hidden="true">·</span>
				<span>{paperCount} {paperCount === 1 ? 'paper' : 'papers'}</span>
			</p>
		</header>

		<div class="relative grid items-start" data-reading-layout>
			<main class="col-start-1 row-start-1 mx-auto w-full max-w-3xl min-w-0">
				<article class="content paper-digest-content" data-pagefind-body lang={language}>
					<div class="hidden" data-pagefind-ignore>
						<h1 data-pagefind-meta="title">{title}</h1>
						<span data-pagefind-meta="date">{publishedIso.slice(0, 10)}</span>
						<span data-pagefind-filter="Type" data-pagefind-meta="type">Paper Digest</span>
					</div>
					<PostContent><Content /></PostContent>
				</article>
			</main>

			<aside
				class="sticky top-20 col-start-1 row-start-1 hidden w-56 xl:block"
				style="margin-left: calc(50% + 26rem);"
				data-post-toc
			>
				<TableOfContents label="On this page" />
			</aside>
		</div>
	</Section>
	<ScrollToTop />
</Base>

<style is:global>
	.paper-digest-content .note-content {
		font-size: 1rem;
		line-height: 1.8;
	}

	.paper-digest-content .note-content h2 {
		margin-top: 3.5rem;
		margin-bottom: 0.65rem;
		border-left: 4px solid rgb(234 88 12);
		padding: 0.7rem 0 0.7rem 1rem;
		font-family:
			ui-sans-serif,
			-apple-system,
			BlinkMacSystemFont,
			'Segoe UI',
			sans-serif;
		font-size: clamp(1.3rem, 3.8vw, 1.6rem);
		line-height: 1.3;
		letter-spacing: -0.035em;
	}

	.dark .paper-digest-content .note-content h2 {
		border-left-color: rgb(251 146 60);
	}

	.paper-digest-content .note-content h2 a {
		transition: color 160ms ease;
	}

	.paper-digest-content .note-content h2 a:hover {
		color: rgb(194 65 12);
	}

	.dark .paper-digest-content .note-content h2 a:hover {
		color: rgb(251 146 60);
	}

	.paper-digest-content .note-content .paper-title-zh {
		margin-top: -0.25rem;
		margin-bottom: 1.5rem;
		padding-left: calc(1rem + 4px);
		color: rgb(120 113 108);
		font-family:
			ui-sans-serif,
			-apple-system,
			BlinkMacSystemFont,
			'Segoe UI',
			sans-serif;
		font-size: 0.95rem;
		font-weight: 500;
		line-height: 1.6;
	}

	.dark .paper-digest-content .note-content .paper-title-zh {
		color: rgb(168 162 158);
	}

	.paper-digest-content .note-content h3 {
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		border-top: 1px solid rgb(231 229 228);
		padding-top: 1rem;
		font-family:
			ui-sans-serif,
			-apple-system,
			BlinkMacSystemFont,
			'Segoe UI',
			sans-serif;
		font-size: clamp(1.08rem, 3vw, 1.22rem);
		letter-spacing: -0.025em;
	}

	.dark .paper-digest-content .note-content h3 {
		border-top-color: rgb(68 64 60);
	}

	.paper-digest-content .note-content .paper-verdict-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem 1rem;
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		border-top: 1px solid rgb(231 229 228);
		padding-top: 1rem;
	}

	.dark .paper-digest-content .note-content .paper-verdict-heading {
		border-top-color: rgb(68 64 60);
	}

	.paper-digest-content .note-content .paper-verdict-heading h3 {
		margin: 0;
		border: 0;
		padding: 0;
	}

	.paper-digest-content .note-content .paper-verdict-badge {
		flex: none;
		border: 1px solid rgb(214 211 209);
		border-radius: 999px;
		padding: 0.18rem 0.65rem;
		color: rgb(87 83 78);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.dark .paper-digest-content .note-content .paper-verdict-badge {
		border-color: rgb(68 64 60);
		color: rgb(214 211 209);
	}

	.paper-digest-content .note-content p:has(> strong:only-child) {
		width: fit-content;
		margin-top: 1.1rem;
		margin-bottom: -0.55rem;
		color: rgb(120 113 108);
		font-size: 0.68rem;
		line-height: 1.6;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.paper-digest-content .note-content .note-table-scroll {
		margin-top: 1rem;
		margin-bottom: 1.75rem;
	}

	.paper-digest-content .note-content table {
		min-width: 100%;
		white-space: normal;
	}

	.paper-digest-content .note-content th:first-child,
	.paper-digest-content .note-content td:first-child {
		width: 11rem;
		font-weight: 650;
	}

	.paper-digest-content .note-content hr {
		margin-block: 3.5rem;
	}

	@media (max-width: 640px) {
		.paper-digest-content .note-content h2 {
			margin-top: 3rem;
			padding-left: 0.8rem;
		}

		.paper-digest-content .note-content .paper-title-zh {
			padding-left: calc(0.8rem + 4px);
		}

		.paper-digest-content .note-content h3 {
			margin-top: 2.2rem;
		}

		.paper-digest-content .note-content .paper-verdict-heading {
			align-items: flex-start;
			flex-direction: column;
			margin-top: 2.2rem;
		}

		.paper-digest-content .note-content table {
			min-width: 34rem;
		}
	}
</style>
