---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import { AppConfig } from '@/utils/AppConfig';
import {
	formatPaperDigestDate,
	formatPaperDigestDateZh,
	getPaperDigestSlug,
	loadPaperDigests
} from '@/features/paper-digests/data';

const digests = loadPaperDigests();
const totalPapers = digests.reduce((total, digest) => total + digest.frontmatter.paperCount, 0);
---

<Base
	head={{
		title: `Paper Digests / 论文研究日报 | ${AppConfig.site_name}`,
		description:
			'Bilingual, thesis-aware reviews of recent research on structured memory, knowledge graphs, and agentic retrieval.'
	}}
>
	<Section>
		<header
			class="relative overflow-hidden rounded-[2rem] border border-stone-200 bg-stone-50 px-6 py-10 sm:px-10 sm:py-14 dark:border-stone-800 dark:bg-stone-900/60"
		>
			<div
				class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full bg-orange-200/35 blur-3xl dark:bg-orange-900/20"
			>
			</div>
			<div class="relative max-w-4xl">
				<p
					class="mb-5 text-[0.68rem] font-bold tracking-[0.2em] text-orange-700 uppercase dark:text-orange-400"
				>
					Research intelligence · 研究情报
				</p>
				<h1
					class="max-w-3xl text-[clamp(2.35rem,8vw,5.2rem)] leading-[0.95] font-black tracking-[-0.065em] text-stone-950 dark:text-stone-50"
				>
					Paper Digests
				</h1>
				<p
					class="mt-4 text-xl leading-tight font-semibold tracking-[-0.02em] text-stone-500 sm:text-2xl dark:text-stone-400"
					lang="zh-CN"
				>
					论文研究日报
				</p>

				<div
					class="mt-8 grid max-w-4xl gap-5 border-t border-stone-200 pt-7 md:grid-cols-2 dark:border-stone-700"
				>
					<div>
						<p class="mb-2 text-[0.65rem] font-bold tracking-[0.16em] text-stone-400 uppercase">
							English
						</p>
						<p
							class="text-sm leading-6 text-stone-700 sm:text-base sm:leading-7 dark:text-stone-300"
						>
							A curated, AI-assisted research feed tracking structured agent memory, knowledge
							graphs, multi-hop retrieval, and agentic RAG in relation to my master's thesis.
						</p>
					</div>
					<div lang="zh-CN">
						<p class="mb-2 text-[0.65rem] font-bold tracking-[0.16em] text-stone-400 uppercase">
							中文
						</p>
						<p
							class="text-sm leading-6 text-stone-700 sm:text-base sm:leading-7 dark:text-stone-300"
						>
							一份经过筛选并由 AI 辅助整理的研究动态，持续追踪结构化智能体记忆、知识图谱、多跳检索和
							Agentic RAG 与我的硕士论文之间的联系。
						</p>
					</div>
				</div>

				{
					digests.length > 0 && (
						<div class="mt-8 flex flex-wrap gap-2 text-[0.7rem] font-bold tracking-[0.1em] uppercase">
							<span class="rounded-full border border-stone-300 bg-white/70 px-3 py-1.5 text-stone-600 dark:border-stone-700 dark:bg-stone-950/50 dark:text-stone-300">
								{digests.length} {digests.length === 1 ? 'digest' : 'digests'} / {digests.length} 期
							</span>
							<span class="rounded-full border border-stone-300 bg-white/70 px-3 py-1.5 text-stone-600 dark:border-stone-700 dark:bg-stone-950/50 dark:text-stone-300">
								{totalPapers} {totalPapers === 1 ? 'paper' : 'papers'} / {totalPapers} 篇论文
							</span>
						</div>
					)
				}
			</div>
		</header>
	</Section>

	<Section>
		<div
			class="mb-6 flex items-end justify-between gap-4 border-b border-stone-300 pb-4 dark:border-stone-700"
		>
			<div>
				<p class="text-xs font-bold tracking-[0.15em] text-stone-500 uppercase dark:text-stone-400">
					Archive · 归档
				</p>
				<h2 class="mt-1 text-xl font-bold tracking-[-0.03em] sm:text-2xl">
					Latest briefs / 最新简报
				</h2>
			</div>
		</div>

		{
			digests.length === 0 ? (
				<div class="rounded-2xl border border-dashed border-stone-300 px-6 py-14 text-center dark:border-stone-700">
					<p class="font-semibold text-stone-700 dark:text-stone-300">No digests published yet.</p>
					<p class="mt-1 text-sm text-stone-500 dark:text-stone-400" lang="zh-CN">
						尚未发布论文日报。
					</p>
				</div>
			) : (
				<ol class="grid gap-4">
					{digests.map((digest, index) => {
						const { title, titleZh, pubDate, description, descriptionZh, paperCount } =
							digest.frontmatter;
						return (
							<li>
								<a
									class="group block rounded-2xl border border-stone-200 bg-white p-5 transition duration-200 hover:-translate-y-0.5 hover:border-orange-300 hover:shadow-[0_16px_40px_rgba(28,25,23,0.07)] sm:p-7 dark:border-stone-800 dark:bg-stone-900/45 dark:hover:border-orange-800 dark:hover:shadow-none"
									href={`/papers/${getPaperDigestSlug(digest)}`}
								>
									<div class="grid gap-5 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-7">
										<div class="sm:border-r sm:border-stone-200 sm:pr-6 dark:sm:border-stone-700">
											<span class="block font-mono text-[0.65rem] font-bold tracking-[0.16em] text-orange-700 uppercase dark:text-orange-400">
												Brief {String(digests.length - index).padStart(2, '0')}
											</span>
											<time class="mt-2 block text-xs leading-5 font-semibold text-stone-600 dark:text-stone-300">
												{formatPaperDigestDate(pubDate)}
												<span class="block font-normal text-stone-400" lang="zh-CN">
													{formatPaperDigestDateZh(pubDate)}
												</span>
											</time>
										</div>

										<div class="min-w-0">
											<div class="flex flex-wrap items-start justify-between gap-3">
												<div>
													<h3 class="text-lg leading-snug font-bold tracking-[-0.025em] group-hover:text-orange-700 sm:text-xl dark:group-hover:text-orange-400">
														{title}
													</h3>
													<p
														class="mt-1 text-sm font-semibold text-stone-500 dark:text-stone-400"
														lang="zh-CN"
													>
														{titleZh}
													</p>
												</div>
												<span class="rounded-full bg-stone-100 px-2.5 py-1 text-[0.62rem] font-bold tracking-[0.1em] text-stone-500 uppercase dark:bg-stone-800 dark:text-stone-300">
													{paperCount} {paperCount === 1 ? 'paper' : 'papers'} / {paperCount} 篇
												</span>
											</div>

											<div class="mt-4 grid gap-3 text-sm leading-6 text-stone-600 md:grid-cols-2 dark:text-stone-300">
												<p>{description}</p>
												<p
													class="border-stone-200 md:border-l md:pl-4 dark:border-stone-700"
													lang="zh-CN"
												>
													{descriptionZh}
												</p>
											</div>
											<p class="mt-5 text-xs font-bold tracking-[0.08em] text-orange-700 uppercase dark:text-orange-400">
												Read digest / 阅读日报 <span aria-hidden="true">→</span>
											</p>
										</div>
									</div>
								</a>
							</li>
						);
					})}
				</ol>
			)
		}
	</Section>
</Base>
