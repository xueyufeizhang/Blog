---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import { AppConfig } from '@/utils/AppConfig';
import {
	formatPaperDigestDate,
	getPaperDigestSlug,
	loadPaperDigests
} from '@/features/paper-digests/data';

const digests = loadPaperDigests();
const totalPapers = digests.reduce((total, digest) => total + digest.frontmatter.paperCount, 0);
---

<Base
	head={{
		title: `Paper Digests | ${AppConfig.site_name}`,
		description: 'Selected research papers related to structured memory and agentic retrieval.'
	}}
>
	<Section>
		<header
			class="mx-auto max-w-4xl border-b border-stone-300 pt-0 pb-8 sm:pb-12 dark:border-stone-700"
		>
			<p class="text-xs font-bold tracking-[0.16em] text-orange-700 uppercase dark:text-orange-400">
				Research archive
			</p>
			<h1
				class="mt-3 text-[clamp(2.5rem,8vw,4.8rem)] leading-none font-black tracking-[-0.06em] text-stone-950 dark:text-stone-50"
			>
				Paper Digests
			</h1>
			<p class="mt-6 max-w-2xl text-sm leading-7 text-stone-600 sm:text-base dark:text-stone-300">
				Selected research on structured agent memory, knowledge graphs, multi-hop retrieval, and
				agentic RAG, reviewed in relation to my master's thesis.
			</p>
			{
				digests.length > 0 && (
					<p class="mt-6 text-xs font-bold tracking-[0.08em] text-stone-500 uppercase dark:text-stone-400">
						{digests.length} {digests.length === 1 ? 'digest' : 'digests'} · {totalPapers}{' '}
						{totalPapers === 1 ? 'paper' : 'papers'}
					</p>
				)
			}
		</header>
	</Section>

	<Section>
		<div class="mx-auto max-w-4xl">
			<h2 class="mb-5 text-xl font-bold tracking-[-0.03em] sm:text-2xl">Latest</h2>
			{
				digests.length === 0 ? (
					<p class="rounded-xl border border-dashed border-stone-300 px-6 py-12 text-center text-sm text-stone-500 dark:border-stone-700 dark:text-stone-400">
						No digests published yet.
					</p>
				) : (
					<ol class="grid gap-3">
						{digests.map((digest) => {
							const { title, pubDate, paperCount } = digest.frontmatter;
							return (
								<li>
									<a
										class="group grid gap-3 rounded-xl border border-stone-200 bg-white px-5 py-5 transition hover:border-orange-300 sm:grid-cols-[9rem_minmax(0,1fr)_auto] sm:items-center sm:px-6 dark:border-stone-800 dark:bg-stone-900/40 dark:hover:border-orange-800"
										href={`/papers/${getPaperDigestSlug(digest)}`}
									>
										<time class="text-xs font-semibold text-stone-500 dark:text-stone-400">
											{formatPaperDigestDate(pubDate)}
										</time>
										<div class="min-w-0">
											<h3 class="font-bold tracking-[-0.02em] group-hover:text-orange-700 dark:group-hover:text-orange-400">
												{title}
											</h3>
										</div>
										<span class="text-xs font-bold tracking-[0.08em] text-stone-500 uppercase dark:text-stone-400">
											{paperCount} {paperCount === 1 ? 'paper' : 'papers'} →
										</span>
									</a>
								</li>
							);
						})}
					</ol>
				)
			}
		</div>
	</Section>
</Base>
