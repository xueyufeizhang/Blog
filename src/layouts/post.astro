---
import { AppConfig } from '@/utils/AppConfig';
import Base from '@/layouts/Base.astro';
import PostHeader from '@/components/PostHeader.astro';
import PostContent from '@/components/PostContent.astro';
import Section from '@/components/Section.astro';
import GiscusLoader from '@/components/GiscusLoader.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import ScrollToTop from '@/components/ScrollToTop.astro';

const { description } = AppConfig;
const { frontmatter } = Astro.props;
const searchDate = new Date(frontmatter.updatedDate ?? frontmatter.pubDate).toISOString().slice(0, 10);
---

<Base head={{ title: frontmatter.title, description }}>
  
  <Section>

    <div class="mb-5 w-full sm:mb-8">
      <PostHeader
        title={frontmatter.title}
        author={frontmatter.author}
        tags={frontmatter.tags}
        minutesRead={frontmatter.minutesRead}
        pubDate={frontmatter.pubDate}
		updatedDate={frontmatter.updatedDate}
		type={frontmatter.type}
		status={frontmatter.status}
		language={frontmatter.language}
        isPinned={frontmatter.isPinned}
        img={{ src: frontmatter.image.src, alt: frontmatter.image.alt }}
      />
    </div>

    <div class="flex items-start gap-5">
      
      <main class="min-w-0 grow">
        
        <article class="content" data-pagefind-body>
          
          <div class="hidden" data-pagefind-ignore>
			<h1 data-pagefind-meta="title">{frontmatter.title}</h1>
			<span data-pagefind-meta="description">{frontmatter.excerpt ?? frontmatter.description}</span>
			<span data-pagefind-meta="date">{searchDate}</span>
			<span data-pagefind-meta="readingTime">{frontmatter.minutesRead}</span>
            {frontmatter.tags?.map((tag: string) => (
				<span data-pagefind-filter="Topic">{tag}</span>
            ))}
			{frontmatter.type && (
				<span data-pagefind-filter="Type" data-pagefind-meta="type">{frontmatter.type}</span>
			)}
			{frontmatter.status && (
				<span data-pagefind-filter="Status" data-pagefind-meta="status">{frontmatter.status}</span>
			)}
			{frontmatter.language && (
				<span data-pagefind-filter="Language" data-pagefind-meta="language">{frontmatter.language}</span>
			)}
          </div>

          <PostContent><slot /></PostContent>
        </article>

        <div class="mt-10 sm:mt-8">
            <GiscusLoader />
        </div>
      </main>

      <aside class="hidden lg:block w-60 shrink-0 sticky mt-11 top-13">
        <TableOfContents />
      </aside>

    </div>

  </Section>
<ScrollToTop />
</Base>
