---
import { AppConfig } from '@/utils/AppConfig';
import Base from '@/layouts/Base.astro';
import PostHeader from '@/components/PostHeader.astro';
import PostContent from '@/components/PostContent.astro';
import Section from '@/components/Section.astro';
import GiscusLoader from '@/components/GiscusLoader.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import ScrollToTop from '@/components/ScrollToTop.astro';

const { description } = AppConfig;
const { frontmatter } = Astro.props;
const searchDate = new Date(frontmatter.updatedDate ?? frontmatter.pubDate).toISOString().slice(0, 10);
---

<Base head={{ title: frontmatter.title, description }}>
  
  <Section>

    <div class="mb-7 w-full sm:mb-10">
      <PostHeader
        title={frontmatter.title}
        author={frontmatter.author}
        tags={frontmatter.tags}
        minutesRead={frontmatter.minutesRead}
        pubDate={frontmatter.pubDate}
		updatedDate={frontmatter.updatedDate}
		type={frontmatter.type}
		status={frontmatter.status}
		language={frontmatter.language}
        isPinned={frontmatter.isPinned}
        img={{ src: frontmatter.image.src, alt: frontmatter.image.alt }}
      />
    </div>

    <div class="relative flex items-start gap-8" data-reading-layout>
      
      <main class="mx-auto w-full min-w-0 max-w-3xl grow">
        
        <article class="content" data-pagefind-body>
          
          <div class="hidden" data-pagefind-ignore>
			<h1 data-pagefind-meta="title">{frontmatter.title}</h1>
			<span data-pagefind-meta="description">{frontmatter.excerpt ?? frontmatter.description}</span>
			<span data-pagefind-meta="date">{searchDate}</span>
			<span data-pagefind-meta="readingTime">{frontmatter.minutesRead}</span>
            {frontmatter.tags?.map((tag: string) => (
				<span data-pagefind-filter="Topic">{tag}</span>
            ))}
			{frontmatter.type && (
				<span data-pagefind-filter="Type" data-pagefind-meta="type">{frontmatter.type}</span>
			)}
			{frontmatter.status && (
				<span data-pagefind-filter="Status" data-pagefind-meta="status">{frontmatter.status}</span>
			)}
			{frontmatter.language && (
				<span data-pagefind-filter="Language" data-pagefind-meta="language">{frontmatter.language}</span>
			)}
          </div>

          <PostContent><slot /></PostContent>
        </article>

        <div class="mt-14 border-t border-stone-200 pt-8 dark:border-stone-800 sm:mt-16">
            <GiscusLoader />
        </div>
      </main>

      <aside class="sticky top-20 hidden w-56 shrink-0 lg:block" data-post-toc>
        <TableOfContents />
      </aside>

      <button
        type="button"
        data-toc-expand
        hidden
        class="absolute right-0 top-0 z-10 hidden min-h-10 items-center gap-2 rounded-xl border border-stone-300 bg-stone-100/90 px-3 text-xs font-bold text-stone-600 shadow-sm backdrop-blur-sm transition-colors hover:border-orange-400 hover:text-orange-600 lg:flex dark:border-stone-700 dark:bg-stone-900/90 dark:text-stone-300 dark:hover:border-orange-600 dark:hover:text-orange-400"
        aria-controls="toc-list"
        aria-expanded="false"
        aria-label="Show table of contents"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M8 6h12M8 12h12M8 18h12" stroke-linecap="round"></path>
          <circle cx="4" cy="6" r="0.8" fill="currentColor" stroke="none"></circle>
          <circle cx="4" cy="12" r="0.8" fill="currentColor" stroke="none"></circle>
          <circle cx="4" cy="18" r="0.8" fill="currentColor" stroke="none"></circle>
        </svg>
        Contents
      </button>

    </div>

  </Section>
<ScrollToTop />
</Base>
